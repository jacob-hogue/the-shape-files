 "sql": "SELECT round(sum(ST_Area(ST_Intersection(c.geom, u.geom))) / 10000, 1) AS hectares\nFROM ST_Read('data/x001.gpkg', layer = 'capability') AS c\nJOIN ST_Read('data/x001.gpkg', layer = 'land_use') AS u\n  ON ST_Intersects(c.geom, u.geom)\nWHERE c.class IN (1, 2) AND u.use = 'forest';"
